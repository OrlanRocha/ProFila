{
  "name": "profila/profila",
  "description": "Sistema de gestão de filas com painel de senha em PHP POO + MVC + WebSocket",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "cboden/ratchet": "^0.4.4",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
